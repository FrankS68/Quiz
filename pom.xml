<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- witch-social-parent bringt alles aus witch-parent (Spring Boot, Vaadin, Security/OAuth2,
         JPA + H2, witch-auth, Plugin-Konfiguration inkl. Eclipse/m2e-Workarounds, Repositories)
         und dazu witch-social-core: Konten verbinden, Beitraege posten, Feeds (siehe Repo witch-social). -->
    <parent>
        <groupId>de.witchcafe</groupId>
        <artifactId>witch-social-parent</artifactId>
        <version>1.0.0</version>
        <relativePath/>
    </parent>

    <artifactId>vaadinquiz</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>Quiz</name>
    <description>Quiz mit Fragenkatalogen (JSON-Upload) und Ergebnissen je Benutzer</description>

    <properties>
        <!-- witch-social-parent 1.0.0 haengt noch an witch-parent 1.0.0; witch-ui 1.1.0 bringt die
             Smartphone-Helfer (Responsive, witch-ui.css), 1.2.0 das gruppierte Menue (Anwendung/
             Social/Billing/Admin) und nur noch einen DrawerToggle, 1.3.0 Impressum und Hilfe.
             Entfaellt, sobald es ein witch-social-parent auf Basis von witch-parent 1.1.0 gibt. -->
        <witch-ui.version>1.3.0</witch-ui.version>
        <!-- feste witch-auth-Version statt 1.0.0-SNAPSHOT (Secret-Wartung); SNAPSHOTs aus GitHub
             Packages blieben im Docker-Build wegen veralteter Metadaten alt -->
        <witch-auth.version>1.1.4</witch-auth.version>
    </properties>

    <dependencies>
        <!-- Gemeinsames Layout, Menue, ViewToolbar, Benutzerverwaltung, OAuth-Provider-Status -->
        <dependency>
            <groupId>de.witchcafe</groupId>
            <artifactId>witch-ui</artifactId>
        </dependency>
        <!-- Social-Netzwerke: nur die, die das Quiz koennen soll -->
        <dependency>
            <groupId>de.witchcafe</groupId>
            <artifactId>witch-bluesky</artifactId>
        </dependency>
        <dependency>
            <groupId>de.witchcafe</groupId>
            <artifactId>witch-mastodon</artifactId>
        </dependency>
        <!-- Gemeinsames Guthabenkonto (witch-billing): Runden zaehlen, Beitraege gutschreiben;
             wer im Minus ist, sieht Werbung statt gesperrt zu werden (bringt den Client mit).
             Ohne witch-billing.url ausgeschaltet, dann ist alles frei. -->
        <dependency>
            <groupId>de.witchcafe</groupId>
            <artifactId>witch-billing-vaadin</artifactId>
            <version>0.3.0</version>
        </dependency>
        <!-- OpenAPI-Beschreibung der REST-API unter /api/docs/openapi.json (wie knownet) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
            <version>3.1.0</version>
        </dependency>
        <!-- KI-Fragengenerator (Kategorien anlegen/erweitern): Claude ueber die Anthropic-API.
             Mistral, OpenAI und Gemini werden per RestClient angesprochen. -->
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>3.12.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!-- Noetig, damit Maven witch-social-parent selbst findet (Token in ~/.m2/settings.xml, server-id "github") -->
    <repositories>
        <repository>
            <id>github</id>
            <name>GitHub FrankS68 Maven Packages</name>
            <url>https://maven.pkg.github.com/FrankS68/witch-auth</url>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>
</project>
